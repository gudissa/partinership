# Backend environment example
PORT=5000
MONGODB_URI=mongodb://localhost:27017/pms
JWT_SECRET=your_jwt_secret_here

# Frontend app URLs used for setup links and emails
ADMIN_APP_URL=http://localhost:5173
USER_APP_URL=http://localhost:5174

# Optional: general frontend base
# FRONTEND_BASE_URL=http://localhost:5174

# CORS: comma-separated list of allowed origins (overrides defaults when set)
# Example: CORS_ORIGINS=http://192.168.1.100:5173,http://192.168.1.101:5174
# If not set, ADMIN_APP_URL and USER_APP_URL are used, plus localhost defaults
# For production it's recommended to set explicit origins or use a stable domain
# e.g. CORS_ORIGINS=https://app.example.com
#
# You can also set HOST=0.0.0.0 to force server to bind to all interfaces
# HOST=0.0.0.0
